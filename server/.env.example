# Copy this file to server/.env and fill in values:
#   copy server\.env.example server\.env

# FREE plant ID key — https://my.plantnet.org/ (Sign up → API access)
PLANTNET_API_KEY=

# PlantNet project (usually "all")
PLANTNET_PROJECT=all

# Server port
PORT=5000

# Optional but recommended: free Hugging Face token for more reliable
# leaf disease detection (required by HF for many free models now)
# Create token: https://huggingface.co/settings/tokens (Read access is enough)
HF_TOKEN=

# Optional: reject PlantNet matches below this score (0–1)
# MIN_PLANT_SCORE=0.15

# Optional: override disease model on Hugging Face
# DISEASE_MODEL=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# Optional: free HF chat model for Plant Buddy (dynamic AI answers)
# Recommended free router models:
# CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
# CHAT_MODEL=openai/gpt-oss-120b:together

# MySQL scan history storage
# Create this database first, then restart the server.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=db_puno

# Alternative single connection string:
# MYSQL_URL=mysql://root:password@localhost:3306/db_puno
